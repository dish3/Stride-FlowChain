{
  "include": ["src/**/*.ts", "src/**/*.tsx", "eslint.config.js"],
  "compilerOptions": {
    "target": "es2022",
    "jsx": "react-jsx",
    "module": "esnext",
    "lib": ["es2022", "dom", "dom.iterable"],
    "typeRoots": ["./client/node_modules/@types", "./node_modules/@types"],
    "types": ["react", "react-dom"],
    "baseUrl": ".",

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "react": ["./client/node_modules/@types/react"],
      "react/jsx-runtime": ["./client/node_modules/@types/react/jsx-runtime"],
      "react-dom": ["./client/node_modules/@types/react-dom"],
      "react-dom/client": ["./client/node_modules/@types/react-dom/client"],
      "@/lib/api": ["./client/src/lib/api"],
      "@/lib/db": ["./client/src/lib/db"],
      "@/*": ["./src/*"],
      "*": ["./client/node_modules/*", "./node_modules/*"]
    }
  }
}
